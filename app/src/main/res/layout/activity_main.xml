<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 SHADOW PANEL v3.0"
        android:textSize="32sp"
        android:textColor="#ff6b35"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"/>

    <Switch
        android:id="@+id/switch_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 Auto Head"
        android:textColor="#ffffff"
        android:padding="15dp"/>

    <Switch
        android:id="@+id/switch_esp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📦 Box ESP"
        android:textColor="#ffffff"
        android:padding="15dp"/>

    <Switch
        android:id="@+id/switch_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📏 Line ESP"
        android:textColor="#ffffff"
        android:padding="15dp"/>

    <Switch
        android:id="@+id/switch_antiban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛡️ AntiBan Shield"
        android:textColor="#ffffff"
        android:padding="15dp"
        android:checked="true"/>

    <Button
        android:id="@+id/btn_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Update Offsets"
        android:background="#ff6b35"
        android:textColor="#ffffff"
        android:layout_marginTop="40dp"
        android:padding="15dp"/>

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textColor="#00ff88"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:textSize="16sp"/>

</LinearLayout>
